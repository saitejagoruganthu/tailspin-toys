---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const filterCategories = await getAllCategories(getDatabase());
const filterPublishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <form
        class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5"
        data-testid="game-filters"
        aria-label="Filter games"
      >
        <div class="grid gap-6 md:grid-cols-[2fr_1fr_auto] md:items-end">
          <fieldset>
            <legend class="mb-3 text-sm font-medium text-slate-200">Categories</legend>
            <div class="flex flex-wrap gap-3">
              {filterCategories.map((category) => (
                <label class="inline-flex cursor-pointer items-center gap-2 text-sm text-slate-300">
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    data-testid={`category-filter-${category.id}`}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <label class="block text-sm font-medium text-slate-200">
            <span class="mb-3 block">Publisher</span>
            <select
              name="publisher"
              data-testid="publisher-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
              <option value="">All publishers</option>
              {filterPublishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
          </label>

          <div class="flex gap-3">
            <button
              type="submit"
              data-testid="apply-filters"
              class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
              Apply filters
            </button>
            <a
              href="/"
              data-testid="clear-filters"
              class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
              Clear
            </a>
          </div>
        </div>
      </form>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <div class="hidden" data-testid="filtered-empty-state">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
    const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
    const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');

    if (form && cards.length > 0 && emptyState && grid) {
        const categoryInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]'));
        const publisherInput = form.querySelector<HTMLSelectElement>('select[name="publisher"]');

        const applyFilters = (updateUrl: boolean): void => {
            const params = new URLSearchParams(updateUrl ? '' : window.location.search);
            const selectedCategories = updateUrl
                ? categoryInputs.filter((input) => input.checked).map((input) => input.value)
                : params.getAll('category');
            const selectedPublisher = updateUrl
                ? publisherInput?.value ?? ''
                : params.get('publisher') ?? '';

            categoryInputs.forEach((input) => {
                input.checked = selectedCategories.includes(input.value);
            });
            if (publisherInput) {
                publisherInput.value = selectedPublisher;
            }

            let visibleCount = 0;
            cards.forEach((card) => {
                const categoryMatches =
                    selectedCategories.length === 0 ||
                    selectedCategories.includes(card.dataset.gameCategoryId ?? '');
                const publisherMatches =
                    selectedPublisher === '' || selectedPublisher === card.dataset.gamePublisherId;
                const visible = categoryMatches && publisherMatches;
                card.hidden = !visible;
                visibleCount += visible ? 1 : 0;
            });

            grid.hidden = visibleCount === 0;
            emptyState.classList.toggle('hidden', visibleCount > 0);
        };

        form.addEventListener('submit', (event): void => {
            event.preventDefault();
            const params = new URLSearchParams();
            categoryInputs.filter((input) => input.checked).forEach((input) => params.append('category', input.value));
            if (publisherInput?.value) {
                params.set('publisher', publisherInput.value);
            }
            const query = params.toString();
            window.history.replaceState({}, '', query ? `/?${query}` : '/');
            applyFilters(true);
        });

        applyFilters(false);
    }
</script>
